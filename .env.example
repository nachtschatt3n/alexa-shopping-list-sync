# Copy to .env and fill in. .env is gitignored.
# Used by `make test-int` to run integration tests against a real Amazon account.
# Use a SECONDARY Amazon account, not your main one — iteration can spam your list.

ALEXA_EMAIL=
ALEXA_PASSWORD=
ALEXA_URL=amazon.de
# Optional: TOTP secret if your account has authenticator-app 2FA enabled
# (without it, you'll be prompted on the CLI). Leave blank if you use SMS.
ALEXA_OTP_SECRET=
